# ========================================================
# FoodSaathi — Frontend Environment Configuration
# ========================================================

# Base API URL (Local development uses Vite proxy '/api')
# Production deployment on Vercel: https://foodsaathi-api.onrender.com/api
VITE_API_URL=/api

# Google OAuth 2.0 Web Client ID (matches backend GOOGLE_CLIENT_ID)
# Ensure Google Cloud Console Authorized JavaScript Origins includes:
# - http://localhost:5173
# - https://your-production-app.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
